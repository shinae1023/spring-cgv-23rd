SPRING_PROFILES_ACTIVE=prod

# Database
# H2 memory DB is used when these values are omitted.
# Use a persistent database in production.
DB_URL=jdbc:mysql://your-db-host:3306/vote_service
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
JPA_DDL_AUTO=update
H2_CONSOLE_ENABLED=false

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# CORS
# Comma-separated origins. Include the deployed frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Optional admin seed
ADMIN_SEED_ENABLED=false
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PART=BACKEND
ADMIN_TEAM=IPX
